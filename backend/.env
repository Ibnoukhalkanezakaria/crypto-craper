# Test Configuration - DO NOT USE IN PRODUCTION

# API Keys (Using test/demo values)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
MESSARI_API_KEY=
GLASSNODE_API_KEY=
SANTIMENT_API_KEY=
LUNARCRUSH_API_KEY=
CRYPTOQUANT_API_KEY=
DEFILLAMA_API_KEY=
TOKEN_UNLOCKS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://crypto_user:crypto_password@localhost:5432/crypto_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_db
DB_USER=crypto_user
DB_PASSWORD=crypto_password

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGODB_URL=mongodb://localhost:27017/crypto_reports
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=crypto_reports

# Notification Services
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=crypto-agent@test.com
EMAIL_TO=test@test.com

# Application Settings
ENVIRONMENT=development
DEBUG=True

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=test_secret_key_change_in_production_12345678901234567890

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Agent Configuration
DATA_COLLECTION_INTERVAL=60
TOP_COINS_COUNT=10
PHASE_DETECTION_INTERVAL=6
FUNDAMENTAL_ANALYSIS_DEPTH=basic
ONCHAIN_ANALYSIS_INTERVAL=4
SCORING_UPDATE_INTERVAL=30

# ML Model Settings
MODEL_RETRAIN_INTERVAL=7
ALERT_CONFIDENCE_THRESHOLD=0.75
BACKTESTING_PERIOD=365

# Scraping Configuration
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36
SCRAPING_DELAY=2
MAX_CONCURRENT_REQUESTS=5
SELENIUM_HEADLESS=True

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
JWT_SECRET_KEY=test_jwt_secret_key_change_in_production_12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=/tmp/crypto-agent.log

# Feature Flags
ENABLE_TELEGRAM_ALERTS=False
ENABLE_DISCORD_ALERTS=False
ENABLE_EMAIL_ALERTS=False
ENABLE_WEB_SCRAPING=True
ENABLE_ML_MODELS=True
ENABLE_SENTIMENT_ANALYSIS=False
ENABLE_ONCHAIN_ANALYSIS=False

# Performance
CACHE_TTL=300
MAX_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
